# ---------------------------------------------------------------------------
# Probe backend configuration. Copy to .env and fill in.
# Values here are the development placeholders documented in docs/KEYS.md.
# None of them authenticate against a real service.
# ---------------------------------------------------------------------------

# --- This application ------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROBE_SECRET_KEY=cHJvYmVfZGV2X2Zlcm5ldF9rZXlfMzJieXRlc19hYmNkZWY=
PROBE_API_KEY=probe-local-dev-key-7f3a9c
PROBE_STATE_PATH=./probe-state.json
PROBE_CORS_ORIGINS=http://localhost:5173
# auto | elastic_connector | direct_jira
PROBE_TICKET_ROUTE=auto

# --- Elasticsearch ---------------------------------------------------------
ELASTIC_ES_URL=http://localhost:9200
ELASTIC_API_KEY=UHJvYmVEZXZLZXlJZDpQcm9iZURldkFwaUtleVNlY3JldFZhbHVl
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=probe-dev-es-passw0rd
ELASTIC_VERIFY_TLS=false
ELASTIC_CA_CERT_PATH=

# --- Kibana ----------------------------------------------------------------
KIBANA_URL=http://localhost:5601
# Blank falls back to ELASTIC_API_KEY, then to ELASTIC_USERNAME/PASSWORD.
KIBANA_API_KEY=

# --- Elasticsearch content connector --------------------------------------
ES_CONNECTOR_ID=probe-jira-connector
ES_CONNECTOR_INDEX=search-jira-probe
ES_CONNECTOR_NAME=Probe Jira content connector
ES_CONNECTOR_SERVICE_TYPE=jira
ES_CONNECTOR_SYNC_INTERVAL=0 0 */3 * * ?

# --- Jira Cloud ------------------------------------------------------------
# Normally entered through the UI rather than set here; these seed the form.
JIRA_BASE_URL=https://probe-demo.atlassian.net
JIRA_ACCOUNT_EMAIL=probe-bot@example.com
JIRA_API_TOKEN=ATATT3xFfGF0T_pR0b3_dEv_pLaCeHoLdEr_t0k3n_9c1f4e2a
JIRA_PROJECT_KEY=PROBE
JIRA_DEFAULT_ISSUE_TYPE=Task
